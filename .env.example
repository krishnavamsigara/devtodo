# =================================================================
# Docker Compose Environment Configuration (.env)
# =================================================================

# Docker Hub Registry
DOCKERHUB_USERNAME=krishnavamsigara
IMAGE_TAG=latest

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postsdb
POSTGRES_PORT=5432

# Backend API Service
NODE_ENV=production
BACKEND_PORT=5000
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Frontend Web Service
FRONTEND_PORT=3000
FRONTEND_ALT_PORT=5173
VITE_API_URL=/api
