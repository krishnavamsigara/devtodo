# ==========================================
# Application Environment Configuration
# ==========================================
NODE_ENV=production
PORT=5000
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=1d

# ==========================================
# Database Configuration
# ==========================================
# OPTION 1: Neon DB (Serverless Cloud PostgreSQL)
# Example: postgresql://<user>:<password>@<ep-pooler-region>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_sample@ep-quiet-star-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTION 2: Local PostgreSQL Container (when running local-db profile)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postsdb?schema=public

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=/api
